{
  "name": "tic-tac-toe-with-minimax",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "play": "tsx cli.ts",
    "play:easy": "tsx cli.ts --difficulty=easy",
    "play:medium": "tsx cli.ts --difficulty=medium",
    "play:random": "tsx cli.ts --random"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
